    "    y_modell = np.polyval(koeff, z)           # Modellwerte berechnen\n",
    "\n",
    "    # R² direkt ausrechnen: 1 - (nicht erklärte Schwankung / gesamte Schwankung)\n",
    "    r2_wert = 1 - np.sum((y - y_modell)**2) / np.sum((y - np.mean(y))**2)\n",
    "\n",
    "    # Koeffizienten als Text: a = ..., b = ..., c = ...\n",
