    "# Aufteilen: Training 1994-2018 (25 Jahre), Test 2019-2026 (8 Jahre)\n",
    "train = umsatz[umsatz[\"Jahr\"] <= 2018]\n",
    "test  = umsatz[umsatz[\"Jahr\"] >= 2019]\n",
    "print(len(train), \"Trainingsjahre,\", len(test), \"Testjahre\")\n",
    "\n",
    "# Standardisierung nur aus den Trainingsjahren, sonst fließt Wissen aus dem Test ein\n",
    "mw_train = train[\"Jahr\"].mean()\n",
    "sd_train = train[\"Jahr\"].std()\n",
    "\n",
    "z_train = ((train[\"Jahr\"] - mw_train) / sd_train).values\n",
    "z_test  = ((test[\"Jahr\"]  - mw_train) / sd_train).values   #gleiche Umrechnung wie im Training: Die Koeffizienten gelten nur für diese z-Skala\n",
    "y_train = train[\"Umsatz_Mio_EUR\"].values\n",
    "y_test  = test[\"Umsatz_Mio_EUR\"].values\n",
    "\n",
    "# Maße: R² und RMSE (mittlerer Fehler in Mio. €)\n",
    "def r2(y_echt, y_modell):\n",
    "    return 1 - np.sum((y_echt - y_modell)**2) / np.sum((y_echt - np.mean(y_echt))**2)\n",
    "\n",
    "def rmse(y_echt, y_modell):\n",
    "    return np.sqrt(np.mean((y_echt - y_modell)**2))\n",
    "\n",
    "zeilen = []\n",
    "\n",
    "# Polynome: nur auf Training schätzen, dann auf Training UND Test anwenden\n",
    "for name, grad in [(\"Linear\", 1), (\"Polynom 2. Grades\", 2),\n",
    "                   (\"Polynom 4. Grades\", 4), (\"Polynom 6. Grades\", 6)]:\n",
    "    koeff = np.polyfit(z_train, y_train, grad)\n",
    "    pred_train = np.polyval(koeff, z_train)\n",
    "    pred_test  = np.polyval(koeff, z_test)\n",
    "    zeilen.append({\"Modell\": name,\n",
    "                   \"R² Train\": r2(y_train, pred_train), \"R² Test\": r2(y_test, pred_test),\n",
    "                   \"RMSE Train\": rmse(y_train, pred_train), \"RMSE Test\": rmse(y_test, pred_test)})\n",
    "\n",
    "# Exponentialfunktion: wieder über den Logarithmus, nur auf Training\n",
    "b_e, ln_a_e = np.polyfit(z_train, np.log(y_train), 1)\n",
    "a_e = np.exp(ln_a_e)\n",
    "pred_train = a_e * np.exp(b_e * z_train)\n",
    "pred_test  = a_e * np.exp(b_e * z_test)\n",
    "zeilen.append({\"Modell\": \"Exponentialfunktion\",\n",
    "               \"R² Train\": r2(y_train, pred_train), \"R² Test\": r2(y_test, pred_test),\n",
    "               \"RMSE Train\": rmse(y_train, pred_train), \"RMSE Test\": rmse(y_test, pred_test)})\n",
    "\n",
    "ergebnis = pd.DataFrame(zeilen)\n",
    "ergebnis[\"Verlust R² (Train − Test)\"] = ergebnis[\"R² Train\"] - ergebnis[\"R² Test\"]\n",
    "print(ergebnis.round(4).to_string(index=False))\n",
    "\n",
    "print(z_train.min(), z_train.max())\n",
    "print(z_test.min(), z_test.max())\n",
    "print(np.max(np.abs(z_train))**6, np.max(z_test)**6)"
   ]
  },
